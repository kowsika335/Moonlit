{
  "name": "moonlit",
  "version": "1.0.0",
  "description": "Moonlit - a dating app that connects strangers. Node.js, Express.js and Supabase (PostgreSQL) back end with a React front end.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon --watch server --watch client -e js,jsx --exec \"npm run build && node server/index.js\"",
    "build": "node client/build.js",
    "seed": "node server/seed.js",
    "test": "node --test test/api.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-react": "^7.24.0",
    "nodemon": "^3.1.0"
  },
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs"
}
