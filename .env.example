# Copy this file to ".env" and fill in your own values.
# The ".env" file is private. Never upload it to GitHub.

# Port the server runs on
PORT=5000

# Your Supabase project. Find both in the Supabase dashboard:
#   Project Settings -> API
# SUPABASE_URL is the "Project URL", for example https://abcdxyzcompany.supabase.co
SUPABASE_URL=upuihocvnsyxksgqogoes
# SUPABASE_SERVICE_ROLE_KEY is the secret "service_role" key (NOT the anon key).
# It is a master key: keep it only here on the server and never put it in the front end.
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_LNqwVbkgdecxlyEBySTsyQ_ji5sRfs2

# A long random secret used to sign login tokens.
# Create one by running:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts
JWT_EXPIRES_IN=7d

# development or production
NODE_ENV=development

# Only needed if your front end is hosted on a different address than this server
# CLIENT_ORIGIN=http://localhost:3000
